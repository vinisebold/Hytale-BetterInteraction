@PrimaryButtonStyle = TextButtonStyle(
    Default: (Background: #3b82f6, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #2563eb, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #1d4ed8, LabelStyle: (FontSize: 14, TextColor: #e0e7ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@SecondaryButtonStyle = TextButtonStyle(
    Default: (Background: #374151, LabelStyle: (FontSize: 14, TextColor: #d1d5db, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #4b5563, LabelStyle: (FontSize: 14, TextColor: #f3f4f6, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #1f2937, LabelStyle: (FontSize: 14, TextColor: #d1d5db, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@DangerButtonStyle = TextButtonStyle(
    Default: (Background: #dc2626, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #b91c1c, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #991b1b, LabelStyle: (FontSize: 14, TextColor: #fee2e2, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@SuccessButtonStyle = TextButtonStyle(
    Default: (Background: #10b981, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #059669, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #047857, LabelStyle: (FontSize: 14, TextColor: #d1fae5, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@NavButtonStyle = TextButtonStyle(
    Default: (Background: #1f2937, LabelStyle: (FontSize: 15, TextColor: #9ca3af, RenderBold: false, VerticalAlignment: Center)),
    Hovered: (Background: #374151, LabelStyle: (FontSize: 15, TextColor: #f3f4f6, RenderBold: false, VerticalAlignment: Center)),
    Pressed: (Background: #111827, LabelStyle: (FontSize: 15, TextColor: #9ca3af, RenderBold: false, VerticalAlignment: Center))
);

@NavButtonActiveStyle = TextButtonStyle(
    Default: (Background: #3b82f6, LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center)),
    Hovered: (Background: #2563eb, LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center)),
    Pressed: (Background: #1d4ed8, LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center))
);

Group {
    Anchor: (Width: 960, Height: 640);
    LayoutMode: Left;

    Group #LeftPanel {
        Anchor: (Width: 260);
        Background: #0f172a(0.97);
        LayoutMode: Top;
        Padding: (Full: 28);

        Group #Header {
            LayoutMode: Top;
            Anchor: (Height: 92);

            Label {
                Text: "BETTER INTERACTION";
                Anchor: (Height: 30);
                Style: (FontSize: 14, TextColor: #3b82f6, RenderUppercase: true, LetterSpacing: 2, RenderBold: true);
            }

            Group { Anchor: (Height: 10); }

            Label {
                Text: "Menu de Interação Avançado";
                Anchor: (Height: 26);
                Style: (FontSize: 13, TextColor: #64748b);
            }
        }

        Group { Anchor: (Height: 20); }

        Group {
            Anchor: (Height: 2);
            Background: #1e293b;
        }

        Group { Anchor: (Height: 28); }

        Label {
            Text: "NAVEGAÇÃO";
            Anchor: (Height: 22);
            Style: (FontSize: 11, TextColor: #475569, RenderUppercase: true, LetterSpacing: 1.5, RenderBold: true);
        }

        Group { Anchor: (Height: 14); }

        TextButton #NavSettingsActive {
            Text: "  ⚙  Configurações";
            Anchor: (Height: 46);
            Style: @NavButtonActiveStyle;
            Visible: true;
        }

        TextButton #NavSettingsInactive {
            Text: "  ⚙  Configurações";
            Anchor: (Height: 46);
            Style: @NavButtonStyle;
            Visible: false;
        }

        Group { Anchor: (Height: 8); }

        TextButton #NavInteractionsActive {
            Text: "  ◈  Interações";
            Anchor: (Height: 46);
            Style: @NavButtonActiveStyle;
            Visible: false;
        }

        TextButton #NavInteractionsInactive {
            Text: "  ◈  Interações";
            Anchor: (Height: 46);
            Style: @NavButtonStyle;
            Visible: true;
        }

        Group { Anchor: (Height: 8); }

        TextButton #NavAboutActive {
            Text: "  ℹ  Sobre";
            Anchor: (Height: 46);
            Style: @NavButtonActiveStyle;
            Visible: false;
        }

        TextButton #NavAboutInactive {
            Text: "  ℹ  Sobre";
            Anchor: (Height: 46);
            Style: @NavButtonStyle;
            Visible: true;
        }

        Group { FlexWeight: 1; }

        Group {
            Anchor: (Height: 2);
            Background: #1e293b;
        }

        Group { Anchor: (Height: 20); }

        Group #Footer {
            LayoutMode: Top;
            Anchor: (Height: 70);

            Label {
                Text: "Versão 1.0.0";
                Anchor: (Height: 22);
                Style: (FontSize: 12, TextColor: #475569);
            }

            Group { Anchor: (Height: 6); }

            Label {
                Text: "Por ViniSebold";
                Anchor: (Height: 22);
                Style: (FontSize: 12, TextColor: #64748b);
            }
        }
    }

    Group #RightPanel {
        FlexWeight: 1;
        Background: #1e293b(0.98);
        LayoutMode: Top;
        Padding: (Full: 40);

        Group #PageContainer {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            Padding: (Right: 8);
            Overscroll: false;

            Group #PageSettings {
                LayoutMode: Top;
                Visible: true;

            Group #HeaderSection {
                LayoutMode: Top;
                Anchor: (Height: 112);

                Label {
                    Text: "Configurações";
                    Anchor: (Height: 44);
                    Style: (FontSize: 28, TextColor: #f1f5f9, RenderBold: true);
                }

                Label {
                    Text: "Personalize a experiência de interação do mod";
                    Anchor: (Height: 26);
                    Style: (FontSize: 15, TextColor: #94a3b8);
                }
            }

            Group { Anchor: (Height: 28); }

            Group #SettingsCard1 {
                LayoutMode: Top;
                Background: #0f172a(0.6);
                Padding: (Full: 24, Bottom: 34);
                Anchor: (Height: 165);

                Label {
                    Text: "Interação com Blocos";
                    Anchor: (Height: 30);
                    Style: (FontSize: 17, TextColor: #f1f5f9, RenderBold: true);
                }

                Group { Anchor: (Height: 10); }

                Label {
                    Text: "Habilitar sistema de interação personalizado para blocos do mundo";
                    Anchor: (Height: 24);
                    Style: (FontSize: 14, TextColor: #94a3b8);
                }

                Group { Anchor: (Height: 14); }

                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 42);

                    TextButton #ToggleBlockInteractionOn {
                        Text: "ATIVADO";
                        Anchor: (Width: 130, Height: 42);
                        Style: @SuccessButtonStyle;
                        Visible: true;
                    }

                    TextButton #ToggleBlockInteractionOff {
                        Text: "DESATIVADO";
                        Anchor: (Width: 130, Height: 42);
                        Style: @DangerButtonStyle;
                        Visible: false;
                    }

                    Group { Anchor: (Width: 14); }

                    TextButton #ConfigureBlocks {
                        Text: "CONFIGURAR";
                        Anchor: (Width: 150, Height: 42);
                        Style: @SecondaryButtonStyle;
                    }
                }
            }

            Group { Anchor: (Height: 20); }

            Group #SettingsCard2 {
                LayoutMode: Top;
                Background: #0f172a(0.6);
                Padding: (Full: 24, Bottom: 34);
                Anchor: (Height: 165);

                Label {
                    Text: "Modo de Depuração";
                    Anchor: (Height: 30);
                    Style: (FontSize: 17, TextColor: #f1f5f9, RenderBold: true);
                }

                Group { Anchor: (Height: 10); }

                Label {
                    Text: "Exibir informações detalhadas sobre interações no chat";
                    Anchor: (Height: 24);
                    Style: (FontSize: 14, TextColor: #94a3b8);
                }

                Group { Anchor: (Height: 14); }

                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 42);

                    TextButton #ToggleDebugOn {
                        Text: "ATIVADO";
                        Anchor: (Width: 130, Height: 42);
                        Style: @SuccessButtonStyle;
                        Visible: false;
                    }

                    TextButton #ToggleDebugOff {
                        Text: "DESATIVADO";
                        Anchor: (Width: 130, Height: 42);
                        Style: @DangerButtonStyle;
                        Visible: true;
                    }

                    Group { Anchor: (Width: 14); }

                    Label {
                        Text: "Útil para desenvolvimento e testes";
                        Anchor: (Width: 280, Height: 42);
                        Style: (FontSize: 13, TextColor: #64748b, VerticalAlignment: Center);
                    }
                }
            }

            Group { Anchor: (Height: 20); }

            Group #SettingsCard3 {
                LayoutMode: Top;
                Background: #0f172a(0.6);
                Padding: (Full: 24, Bottom: 34);
                Anchor: (Height: 165);

                Label {
                    Text: "Performance";
                    Anchor: (Height: 30);
                    Style: (FontSize: 17, TextColor: #f1f5f9, RenderBold: true);
                }

                Group { Anchor: (Height: 10); }

                Label {
                    Text: "Otimizar desempenho reduzindo efeitos visuais";
                    Anchor: (Height: 24);
                    Style: (FontSize: 14, TextColor: #94a3b8);
                }

                Group { Anchor: (Height: 14); }

                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 42);

                    TextButton #PerformanceMode {
                        Text: "BALANCEADO";
                        Anchor: (Width: 150, Height: 42);
                        Style: @PrimaryButtonStyle;
                    }

                    Group { Anchor: (Width: 14); }

                    TextButton #ResetSettings {
                        Text: "RESETAR TUDO";
                        Anchor: (Width: 170, Height: 42);
                        Style: @DangerButtonStyle;
                    }
                }
            }
            }

            Group #PageInteractions {
                LayoutMode: Top;
                Visible: false;

                Group {
                    LayoutMode: Top;
                    Anchor: (Height: 112);

                Label {
                    Text: "Interações";
                    Anchor: (Height: 44);
                    Style: (FontSize: 28, TextColor: #f1f5f9, RenderBold: true);
                }

                Label {
                    Text: "Atalhos rápidos e ações comuns do sistema";
                    Anchor: (Height: 26);
                    Style: (FontSize: 15, TextColor: #94a3b8);
                }
            }

                Group { Anchor: (Height: 28); }

                Group {
                    LayoutMode: Top;
                    Background: #0f172a(0.6);
                    Padding: (Full: 24, Bottom: 34);
                    Anchor: (Height: 165);

                Label {
                    Text: "Atalhos de Interação";
                    Anchor: (Height: 30);
                    Style: (FontSize: 17, TextColor: #f1f5f9, RenderBold: true);
                }

                Group { Anchor: (Height: 10); }

                Label {
                    Text: "Defina ações padrão para interações rápidas";
                    Anchor: (Height: 24);
                    Style: (FontSize: 14, TextColor: #94a3b8);
                }

                Group { Anchor: (Height: 14); }

                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 42);

                    TextButton {
                        Text: "EDITAR ATALHOS";
                        Anchor: (Width: 180, Height: 42);
                        Style: @SecondaryButtonStyle;
                    }
                }
                }
            }

            Group #PageAbout {
                LayoutMode: Top;
                Visible: false;

                Group {
                    LayoutMode: Top;
                    Anchor: (Height: 112);

                Label {
                    Text: "Sobre";
                    Anchor: (Height: 44);
                    Style: (FontSize: 28, TextColor: #f1f5f9, RenderBold: true);
                }

                Label {
                    Text: "Informações do mod e links úteis";
                    Anchor: (Height: 26);
                    Style: (FontSize: 15, TextColor: #94a3b8);
                }
            }

                Group { Anchor: (Height: 28); }

                Group {
                    LayoutMode: Top;
                    Background: #0f172a(0.6);
                    Padding: (Full: 24, Bottom: 34);
                    Anchor: (Height: 165);

                Label {
                    Text: "Better Interaction";
                    Anchor: (Height: 30);
                    Style: (FontSize: 17, TextColor: #f1f5f9, RenderBold: true);
                }

                Group { Anchor: (Height: 10); }

                Label {
                    Text: "Versão 1.0.0 - Desenvolvido por ViniSebold";
                    Anchor: (Height: 24);
                    Style: (FontSize: 14, TextColor: #94a3b8);
                }

                Group { Anchor: (Height: 14); }

                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 42);

                    TextButton {
                        Text: "DOCUMENTAÇÃO";
                        Anchor: (Width: 180, Height: 42);
                        Style: @SecondaryButtonStyle;
                    }
                }
                }
            }

            Group { Anchor: (Height: 16); }
        }

        Group {
            Anchor: (Height: 2);
            Background: #334155;
        }

        Group { Anchor: (Height: 24); }

        Group #FooterButtons {
            LayoutMode: Right;
            Anchor: (Height: 50);

            TextButton #CloseButton {
                Text: "FECHAR";
                Anchor: (Width: 130, Height: 48);
                Style: @SecondaryButtonStyle;
            }
        }
    }
}